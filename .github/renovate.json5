{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Europe/Oslo",
  // One weekly batch is plenty for a dotfiles repo.
  schedule: ["before 6am on monday"],
  // Only version-pinned tools in mise's config are tracked here.
  // winget, apt and brew lists have no Renovate manager; topgrade keeps
  // those up to date on the machine instead.
  enabledManagers: ["mise"],
  mise: {
    // The defaults (**/mise/config{,.*}.toml) miss the managed file,
    // home/dot_config/mise/conf.d/00-chezmoi.toml.tmpl.
    managerFilePatterns: ["/(^|/)mise/conf\\.d/[^/]+\\.toml(\\.tmpl)?$/"],
  },
}
