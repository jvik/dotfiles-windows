# ~/.profile: executed by the command interpreter for login shells (WSL only;
# managed by chezmoi). Based on Ubuntu's /etc/skel/.profile.
# This file is not read by bash(1) if ~/.bash_profile or ~/.bash_login exists.
#
# The interactive shell is fish (env.fish sets up PATH there). This file
# matters for non-fish login shells, above all `wsl -d Ubuntu bash -lc ...`:
# the Windows-side topgrade's `wsl` step finds and runs topgrade that way, and
# topgrade, mise and the rest of the general CLIs live in Homebrew.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and setup the libpam-umask package.
#umask 022

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

# Homebrew (Linuxbrew): PATH, MANPATH, INFOPATH, HOMEBREW_*. Guarded so a fresh
# distro without brew still gets a working login shell.
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi
