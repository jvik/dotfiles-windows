{{ if .isWSL -}}
#!/usr/bin/env bash
# WSL system settings that live outside $HOME (sudo):
#   /etc/wsl.conf                    systemd, default user, interop without the Windows PATH
#   /etc/sysctl.d/99-inotify.conf    inotify limits for VS Code Remote-WSL and file watchers
#   systemd units                    Docker socket-activated, unused snapd off (faster boot)
# Only the keys below are set in /etc/wsl.conf; other sections and keys
# (e.g. ones IT or the distro installer added) are kept as they are.
# Windows dirs that fish needs (System32, PowerShell, OpenSSH, WinGet links,
# VS Code) are added back explicitly by the fish config.
set -euo pipefail

log() { printf '\033[1;34m==>\033[0m [wsl-system] %s\n' "$*"; }

user="$(id -un)"

# ini_set FILE SECTION KEY VALUE: print FILE with KEY=VALUE set in [SECTION].
# Matching is case-insensitive, so e.g. an existing `appendwindowspath=` is
# replaced rather than duplicated.
# Replaces an existing key (first occurrence wins, duplicates dropped), appends
# it to the end of the section, or appends the section to the file.
ini_set() {
    awk -v sec="$2" -v key="$3" -v val="$4" '
        function flush_key() {
            if (insec && !done) { print key "=" val; done = 1 }
        }
        function flush_blanks() {
            while (blanks > 0) { print ""; blanks-- }
        }
        /^[[:space:]]*\[.*\][[:space:]]*$/ {
            flush_key(); flush_blanks()
            name = $0
            gsub(/^[[:space:]]*\[[[:space:]]*|[[:space:]]*\][[:space:]]*$/, "", name)
            insec = (tolower(name) == tolower(sec))
            print; next
        }
        /^[[:space:]]*$/ { blanks++; next }
        {
            flush_blanks()
            if (insec) {
                line = $0
                sub(/^[[:space:]]*/, "", line)
                k = line
                sub(/[[:space:]]*=.*$/, "", k)
                if (line ~ /=/ && tolower(k) == tolower(key)) {
                    if (!done) { print key "=" val; done = 1 }
                    next
                }
            }
            print
        }
        END {
            flush_key(); flush_blanks()
            if (!done) {
                if (NR > 0) print ""
                print "[" sec "]"
                print key "=" val
            }
        }
    ' "$1"
}

tmp="$(mktemp)"
trap 'rm -f "$tmp" "$tmp.next"' EXIT

# --- /etc/wsl.conf ----------------------------------------------------------------
if [ -f /etc/wsl.conf ]; then
    cat /etc/wsl.conf >"$tmp"
else
    : >"$tmp"
fi
while read -r section key value; do
    ini_set "$tmp" "$section" "$key" "$value" >"$tmp.next"
    mv "$tmp.next" "$tmp"
done <<EOF
boot systemd true
user default $user
interop enabled true
interop appendWindowsPath false
EOF

wsl_conf_changed=0
if ! cmp -s "$tmp" /etc/wsl.conf; then
    log "updating /etc/wsl.conf:"
    diff -u /etc/wsl.conf "$tmp" || true
    sudo install -m 0644 "$tmp" /etc/wsl.conf
    wsl_conf_changed=1
else
    log "/etc/wsl.conf already up to date"
fi

# --- inotify limits -----------------------------------------------------------------
# Applied at boot by systemd-sysctl (systemd=true above); also applied now.
sysctl_file=/etc/sysctl.d/99-inotify.conf
cat >"$tmp" <<'EOF'
# Managed by chezmoi (dotfiles-windows). Raised for VS Code Remote-WSL and
# dev-server file watchers.
fs.inotify.max_user_instances = 1024
fs.inotify.max_user_watches = 524288
EOF
if ! cmp -s "$tmp" "$sysctl_file"; then
    log "writing $sysctl_file"
    sudo install -m 0644 "$tmp" "$sysctl_file"
    sudo sysctl -q -p "$sysctl_file" || log "sysctl -p failed (applies at next boot)"
fi

# --- Units that slow down the first WSL start -----------------------------------
# WSL runs the first command only once systemd has finished booting, so every
# unit on the boot path delays the first terminal after `wsl --shutdown` or a
# reboot. Disabled, not stopped: takes effect at the next boot.
#
# The exact systemctl commands below may run without a password
# (/etc/sudoers.d/chezmoi-wsl-system): no wildcards, so the rule allows these
# commands and nothing else. Installing or changing that rule asks for the
# password once; after that this step never prompts.
#   Docker: starts on first use (docker.socket stays enabled and pulls in
#     docker.service and containerd). Saves ~2 s at boot; the first `docker`
#     command takes that long instead, and restart-policy containers no longer
#     start at boot.
#   snapd: only while no snaps are installed (Ubuntu's WSL image ships it unused).
boot_off_docker=(docker.service containerd.service)
boot_off_snapd=(snapd.service snapd.socket snapd.seeded.service)

nopasswd_cmds=()
for unit in "${boot_off_docker[@]}" "${boot_off_snapd[@]}"; do
    nopasswd_cmds+=("/usr/bin/systemctl disable --quiet $unit")
done
nopasswd_cmds+=("/usr/bin/systemctl enable --quiet docker.socket")

# `sudo -n -l CMD` succeeds without a password once any NOPASSWD rule exists
# (sudo's default listpw=any), so this checks the rule without prompting.
sudoers_ok=1
for cmd in "${nopasswd_cmds[@]}"; do
    # shellcheck disable=SC2086 # split the command into its words on purpose
    sudo -n -l $cmd >/dev/null 2>&1 || { sudoers_ok=0; break; }
done
if [ "$sudoers_ok" = 0 ]; then
    sudoers_file=/etc/sudoers.d/chezmoi-wsl-system
    {
        echo "# Managed by chezmoi (dotfiles-windows, run_onchange_after_50-wsl-system)."
        echo "# Lets the WSL system script change boot units without a password."
        printf '%s ALL=(root) NOPASSWD: ' "$user"
        printf '%s, ' "${nopasswd_cmds[@]}" | sed 's/, $//'
        echo
    } >"$tmp"
    if sudo visudo -cqf "$tmp"; then
        log "writing $sudoers_file (password asked once)"
        sudo install -m 0440 -o root -g root "$tmp" "$sudoers_file"
    else
        log "generated sudoers rule failed visudo check; not installing it"
    fi
fi

disable_at_boot() { # REASON UNIT...
    local reason="$1" unit
    shift
    for unit in "$@"; do
        if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
            log "disabling $unit at boot ($reason)"
            sudo systemctl disable --quiet "$unit"
        fi
    done
}

{{- if .features.docker }}
disable_at_boot "socket-activated by docker.socket" "${boot_off_docker[@]}"
if ! systemctl is-enabled --quiet docker.socket 2>/dev/null; then
    sudo systemctl enable --quiet docker.socket
fi
{{- end }}
if command -v snap >/dev/null && [ -z "$(snap list 2>/dev/null | tail -n +2)" ]; then
    disable_at_boot "no snaps installed" "${boot_off_snapd[@]}"
fi

if [ "$wsl_conf_changed" = 1 ]; then
    printf '\n\033[1;33m!!\033[0m /etc/wsl.conf changed. From Windows, run:  wsl --shutdown\n'
    printf '   then wait ~8 seconds and reopen the terminal for it to take effect.\n\n'
fi

log "done"
{{ end -}}
