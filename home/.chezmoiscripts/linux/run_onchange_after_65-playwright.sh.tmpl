{{ if .isWSL -}}
#!/usr/bin/env bash
# Playwright, set up once for every repo:
#   - the system libraries Playwright's browsers need (`playwright install-deps`),
#     so `npx playwright install` in a repo only has to download its browser
#     into the shared ~/.cache/ms-playwright;
#   - Google Chrome stable from Google's .deb (it adds Google's apt repository,
#     so topgrade's apt step updates it), the default browser of Playwright MCP;
#   - Playwright MCP (mise, npm:@playwright/mcp) registered with Claude Code at
#     user scope, headless so it also works inside agent-sandbox (no display).
# Runs after 30-mise (playwright-mcp) and 60-claude-code (claude).
# Bump to re-run: 1
set -euo pipefail

log() { printf '\033[1;34m==>\033[0m [playwright] %s\n' "$*"; }

mcp_name=playwright
chrome_deb_url=https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
mise_shims="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
mcp_command="$mise_shims/playwright-mcp"

brew_bin=/home/linuxbrew/.linuxbrew/bin/brew
if [ -x "$brew_bin" ]; then
    eval "$("$brew_bin" shellenv)"
fi
export PATH="$mise_shims:$HOME/.local/bin:$PATH"

if [ ! -x "$mcp_command" ]; then
    echo "[playwright] $mcp_command not found; it is installed by mise (npm:@playwright/mcp)" >&2
    exit 1
fi

# The playwright CLI that ships inside the MCP package; any recent version
# knows the dependency list for this Ubuntu release.
mcp_dir="$(mise where npm:@playwright/mcp)"
playwright_cli="$(find "$mcp_dir" -path '*/node_modules/playwright/cli.js' -print -quit)"
if [ -z "$playwright_cli" ]; then
    echo "[playwright] playwright/cli.js not found under $mcp_dir" >&2
    exit 1
fi

# Absolute path: under sudo the mise shim would look for root's mise config.
node_bin="$(mise which node)"

sudo -v

log "installing system libraries for Playwright's browsers"
sudo "$node_bin" "$playwright_cli" install-deps chromium firefox webkit

if [ -x /opt/google/chrome/chrome ]; then
    log "Google Chrome already installed (topgrade's apt step updates it)"
else
    log "installing Google Chrome stable"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    # apt reads a local .deb as the _apt user; mktemp -d is 0700, so open it
    # up or apt warns and falls back to reading it as root.
    chmod 755 "$tmp"
    curl -fsSL "$chrome_deb_url" -o "$tmp/google-chrome-stable.deb"
    chmod 644 "$tmp/google-chrome-stable.deb"
    sudo apt-get install -y "$tmp/google-chrome-stable.deb"
fi

if ! command -v claude >/dev/null 2>&1; then
    log "claude not found; skipping the MCP registration"
elif claude mcp get "$mcp_name" >/dev/null 2>&1; then
    # A local change (other flags, another command) is kept.
    log "Claude Code MCP server '$mcp_name' already registered"
else
    log "registering Playwright MCP with Claude Code (user scope)"
    claude mcp add --scope user "$mcp_name" -- "$mcp_command" --headless
fi

log "done"
{{ end -}}
