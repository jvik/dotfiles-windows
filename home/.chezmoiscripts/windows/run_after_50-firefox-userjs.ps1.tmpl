{{- if .isWindows -}}
# chezmoi: run_after_50-firefox-userjs (runs on every apply)
#
# Writes user.js into the default Firefox profile: arkenfox user.js (pinned,
# downloaded by chezmoi as an external, see .chezmoiexternal.toml.tmpl)
# followed by the personal overrides in
# home/.chezmoitemplates/firefox-user-overrides.js. That is the file the
# arkenfox updater would build, without running the updater.
#
# Why a script and not a chezmoi target: the profile folder has a random name
# (Profiles\xxxxxxxx.default-release), so it is looked up in profiles.ini.
# Firefox reads user.js from the profile on every start, so no admin rights or
# enterprise policies are needed; policies set by IT (about:policies) still
# win over it.
#
# Runs on every apply so a profile created later (first Firefox start, profile
# reset) is picked up. It only writes when the content differs and keeps the
# previous file as user.js.chezmoi.bak. Firefox applies it on its next start.
#
# It never fails the apply. Keep this file pure ASCII and Windows PowerShell
# 5.1 compatible; the overrides and the path are embedded base64-encoded.

$ErrorActionPreference = 'Stop'

$arkenfoxPathB64 = '{{ joinPath .chezmoi.destDir "AppData/Local/arkenfox/user.js" | b64enc }}'
$overridesB64 = '{{ include ".chezmoitemplates/firefox-user-overrides.js" | b64enc }}'

function Write-Info([string]$Message) { Write-Host "[firefox] $Message" }

# Reads an ini file into a list of hashtables, one per section; the section
# name is stored under the key 'Section'.
function Read-IniSections([string]$Path) {
    $sections = @()
    $current = $null
    foreach ($rawLine in [System.IO.File]::ReadAllLines($Path)) {
        $line = $rawLine.Trim()
        if ($line -match '^\[(.+)\]$') {
            $current = @{ Section = $Matches[1] }
            $sections += $current
        } elseif (($null -ne $current) -and ($line -match '^([^=;#]+)=(.*)$')) {
            $current[$Matches[1].Trim()] = $Matches[2].Trim()
        }
    }
    return ,$sections
}

# Profile folders Firefox opens by default: the Default= of each
# [Install<hash>] section (one per Firefox installation), or, in an older
# profiles.ini without Install sections, the [ProfileN] marked Default=1.
function Get-DefaultProfileDirs([string]$FirefoxDir) {
    $sections = Read-IniSections (Join-Path $FirefoxDir 'profiles.ini')
    $paths = @()
    foreach ($s in $sections) {
        if ($s.Section.StartsWith('Install') -and $s.ContainsKey('Default')) { $paths += $s['Default'] }
    }
    if ($paths.Count -eq 0) {
        foreach ($s in $sections) {
            if ($s.Section.StartsWith('Profile') -and ($s['Default'] -eq '1') -and $s.ContainsKey('Path')) { $paths += $s['Path'] }
        }
    }
    $dirs = @()
    foreach ($p in ($paths | Select-Object -Unique)) {
        if ([System.IO.Path]::IsPathRooted($p)) {
            $dirs += $p
        } else {
            $dirs += (Join-Path $FirefoxDir ($p -replace '/', '\'))
        }
    }
    return ,$dirs
}

try {
    $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
    $arkenfoxPath = $utf8NoBom.GetString([Convert]::FromBase64String($arkenfoxPathB64))
    $overrides = $utf8NoBom.GetString([Convert]::FromBase64String($overridesB64))

    $firefoxDir = Join-Path $env:APPDATA 'Mozilla\Firefox'
    if (-not (Test-Path -LiteralPath (Join-Path $firefoxDir 'profiles.ini') -PathType Leaf)) {
        Write-Info 'No Firefox profile yet (profiles.ini missing): start Firefox once, then run chezmoi apply again.'
        exit 0
    }
    if (-not (Test-Path -LiteralPath $arkenfoxPath -PathType Leaf)) {
        Write-Warning "[firefox] $arkenfoxPath is missing (arkenfox external not downloaded); skipping user.js."
        exit 0
    }

    # Same order as the arkenfox updater: overrides last, so they win.
    $arkenfox = [System.IO.File]::ReadAllText($arkenfoxPath)
    $desired = $arkenfox.TrimEnd() + "`n`n" + $overrides

    $profileDirs = Get-DefaultProfileDirs $firefoxDir
    if ($profileDirs.Count -eq 0) {
        Write-Info 'profiles.ini names no default profile; skipping user.js.'
        exit 0
    }

    foreach ($dir in $profileDirs) {
        if (-not (Test-Path -LiteralPath $dir -PathType Container)) {
            Write-Warning "[firefox] Profile folder $dir (from profiles.ini) does not exist; skipping it."
            continue
        }
        $target = Join-Path $dir 'user.js'
        if (Test-Path -LiteralPath $target -PathType Leaf) {
            if ([System.IO.File]::ReadAllText($target) -ceq $desired) {
                Write-Info "$target is up to date."
                continue
            }
            Copy-Item -LiteralPath $target -Destination "$target.chezmoi.bak" -Force
            Write-Info "Previous user.js saved as $target.chezmoi.bak"
        }
        [System.IO.File]::WriteAllText($target, $desired, $utf8NoBom)
        Write-Info "Wrote $target (arkenfox + overrides); Firefox applies it on its next start."
    }
} catch {
    Write-Warning ("[firefox] Could not write user.js: {0}" -f $_.Exception.Message)
}
exit 0
{{ end -}}
