{{- if and .isWindows .features.powertoys -}}
# chezmoi: run_after_40-powertoys-keyboard (runs on every apply)
#
# Makes PowerToys Keyboard Manager use the remaps declared in
# home/.chezmoidata/powertoys.yaml (powertoys.keyboardManager). The repo is the
# source of truth: on every apply the four remap sections of
#   %LOCALAPPDATA%\Microsoft\PowerToys\Keyboard Manager\<active profile>.json
# are replaced by the declared ones when they differ. Remaps made in the
# PowerToys editor are therefore undone; copy them into the data file instead.
#
# Why a script and not a chezmoi-managed file: the remap file may hold other
# top-level fields PowerToys adds in later releases, and those are kept. Only
# the remap sections are owned here. settings.json files belong to the
# PowerToys runner and are only read (for the enabled/startup warnings).
#
# The file is created when missing (PowerToys does not create it until the
# editor first saves), so this works before PowerToys has ever been started.
# After a write, the Keyboard Manager engine is told to reload through the
# same named event the PowerToys editor signals after saving.
#
# It never fails the apply. Set features.powertoys = false in the chezmoi
# config to opt out (the remap file is then left as it is).
#
# Keep this file pure ASCII and Windows PowerShell 5.1 compatible. The data is
# embedded base64-encoded because remapKeysToText may contain non-ASCII text.

$ErrorActionPreference = 'Stop'

# Windows PowerShell 5.1 serializes arrays that carry ETS type data as
# {"value":[...],"Count":n}; dropping the System.Array type data avoids it.
# Done first so the comparisons below serialize the same way as the write.
if ($PSVersionTable.PSVersion.Major -lt 6) {
    Remove-TypeData -TypeName System.Array -ErrorAction SilentlyContinue
}

$desiredB64 = '{{ .powertoys.keyboardManager | toJson | b64enc }}'

# Top-level sections of the remap file that this script owns.
$managedSections = @('remapKeys', 'remapKeysToText', 'remapShortcuts', 'remapShortcutsToText')

# Signalled by the PowerToys editor after it saves; the engine then reloads.
$reloadEventName = 'PowerToys_KeyboardManager_Event_Settings'

function Write-Info([string]$Message) { Write-Host "[powertoys] $Message" }

# Returns a copy with object properties sorted by name at every level, so two
# files that differ only in key order compare equal.
function ConvertTo-SortedObject($Value) {
    if ($null -eq $Value) { return $null }
    if ($Value -is [System.Management.Automation.PSCustomObject]) {
        $sorted = [ordered]@{}
        foreach ($p in ($Value.PSObject.Properties | Sort-Object Name)) {
            $sorted[$p.Name] = ConvertTo-SortedObject $p.Value
        }
        return New-Object PSObject -Property $sorted
    }
    if ($Value -is [System.Array]) {
        $items = @()
        foreach ($item in $Value) { $items += ,(ConvertTo-SortedObject $item) }
        return ,$items
    }
    return $Value
}

# Canonical JSON of just the managed sections of a remap file object.
function Get-ManagedSectionsJson($FileObject) {
    $sections = [ordered]@{}
    foreach ($name in $managedSections) {
        $prop = $FileObject.PSObject.Properties[$name]
        if ($null -ne $prop) { $sections[$name] = $prop.Value } else { $sections[$name] = $null }
    }
    return (ConvertTo-SortedObject (New-Object PSObject -Property $sections)) | ConvertTo-Json -Depth 32 -Compress
}

# PowerToys reads key codes with GetNamedString and silently skips an entry
# whose code is a JSON number, so an unquoted YAML code is turned into text.
function Repair-KeyCodeTypes($Sections) {
    foreach ($name in $managedSections) {
        foreach ($list in $Sections.$name.PSObject.Properties) {
            foreach ($entry in @($list.Value)) {
                if ($null -eq $entry) { continue }
                foreach ($field in @('originalKeys', 'newRemapKeys')) {
                    $prop = $entry.PSObject.Properties[$field]
                    if (($null -ne $prop) -and -not ($prop.Value -is [string])) { $prop.Value = [string]$prop.Value }
                }
            }
        }
    }
}

function Read-JsonFile([string]$Path) {
    return [System.IO.File]::ReadAllText($Path) | ConvertFrom-Json
}

# Read-only checks of runner-owned settings: warn, never change them.
function Test-PowerToysSettings([string]$PtRoot) {
    $globalSettings = Join-Path $PtRoot 'settings.json'
    if (-not (Test-Path -LiteralPath $globalSettings -PathType Leaf)) { return }
    try {
        $gs = Read-JsonFile $globalSettings
        $enabledProp = $null
        if ($gs.enabled) { $enabledProp = $gs.enabled.PSObject.Properties['Keyboard Manager'] }
        if (($null -ne $enabledProp) -and (-not [bool]$enabledProp.Value)) {
            Write-Warning '[powertoys] Keyboard Manager is DISABLED: enable it in PowerToys Settings > Keyboard Manager.'
        }
        $startupProp = $gs.PSObject.Properties['startup']
        if (($null -ne $startupProp) -and (-not [bool]$startupProp.Value)) {
            Write-Warning '[powertoys] PowerToys does not start at login, so the remaps are gone after a reboot: turn on PowerToys Settings > General > Run at startup.'
        }
    } catch {
        Write-Info "Could not read $globalSettings ($($_.Exception.Message)); skipping the settings checks."
    }
}

# The remap file of the active profile (normally "default").
function Get-RemapFilePath([string]$KbmDir) {
    $profileName = 'default'
    $kbmSettings = Join-Path $KbmDir 'settings.json'
    if (Test-Path -LiteralPath $kbmSettings -PathType Leaf) {
        try {
            $ks = Read-JsonFile $kbmSettings
            if ($ks.properties -and $ks.properties.activeConfiguration -and $ks.properties.activeConfiguration.value) {
                $profileName = [string]$ks.properties.activeConfiguration.value
            }
        } catch {
            $profileName = 'default'
        }
    }
    return Join-Path $KbmDir ($profileName + '.json')
}

function Send-ReloadSignal {
    try {
        $handle = [System.Threading.EventWaitHandle]::OpenExisting($reloadEventName)
        [void]$handle.Set()
        $handle.Dispose()
        Write-Info 'Told the running Keyboard Manager to reload.'
    } catch [System.Threading.WaitHandleCannotBeOpenedException] {
        Write-Info 'Keyboard Manager is not running; it loads the remaps when PowerToys starts.'
    } catch {
        Write-Warning "[powertoys] Could not signal Keyboard Manager ($($_.Exception.Message)); restart PowerToys to load the remaps."
    }
}

try {
    $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
    $desired = $utf8NoBom.GetString([Convert]::FromBase64String($desiredB64)) | ConvertFrom-Json
    Repair-KeyCodeTypes $desired

    $ptRoot = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys'
    $kbmDir = Join-Path $ptRoot 'Keyboard Manager'
    Test-PowerToysSettings $ptRoot
    $remapFile = Get-RemapFilePath $kbmDir

    $current = $null
    if (Test-Path -LiteralPath $remapFile -PathType Leaf) {
        try {
            $current = Read-JsonFile $remapFile
        } catch {
            Write-Warning "[powertoys] $remapFile is not valid JSON; replacing it (backup kept)."
        }
    }

    if ($null -ne $current) {
        if ((Get-ManagedSectionsJson $current) -eq (Get-ManagedSectionsJson $desired)) {
            Write-Info 'Keyboard Manager remaps match powertoys.yaml: OK.'
            exit 0
        }
        $updated = $current
    } else {
        $updated = New-Object PSObject
    }
    foreach ($name in $managedSections) {
        $updated | Add-Member -NotePropertyName $name -NotePropertyValue $desired.$name -Force
    }

    $out = $updated | ConvertTo-Json -Depth 32

    # Sanity check before touching PowerToys' file.
    if ((Get-ManagedSectionsJson ($out | ConvertFrom-Json)) -ne (Get-ManagedSectionsJson $desired)) {
        Write-Warning '[powertoys] Internal check failed while building the remap file; not writing.'
        exit 0
    }

    if (Test-Path -LiteralPath $remapFile -PathType Leaf) {
        $backup = "$remapFile.chezmoi.bak"
        Copy-Item -LiteralPath $remapFile -Destination $backup -Force
        Write-Info "Remaps differed from powertoys.yaml; previous file saved as $backup."
    } else {
        [void](New-Item -ItemType Directory -Path $kbmDir -Force)
    }
    [System.IO.File]::WriteAllText($remapFile, $out, $utf8NoBom)
    Write-Info "Wrote $remapFile."
    Send-ReloadSignal
} catch {
    Write-Warning ("[powertoys] Could not apply the Keyboard Manager remaps: {0}" -f $_.Exception.Message)
}
exit 0
{{ end -}}
