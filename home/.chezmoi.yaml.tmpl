{{- /*
  chezmoi config template. Applied from BOTH sides of the machine:
    - chezmoi.exe on Windows (targets %USERPROFILE%)
    - chezmoi inside WSL2 Ubuntu (targets ~)

  This is the ONLY file allowed to look at .chezmoi.os / .chezmoi.kernel.
  Everything else (templates, .chezmoiignore, .chezmoiexternal, scripts)
  branches on the data written here: .isWindows / .isWSL / .isLinux.

  Every prompt uses prompt*Once with a default, so
  `chezmoi init --promptDefaults` works non-interactively and re-running
  `chezmoi init` keeps the answers already stored in the config.
*/ -}}

{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isWSL := false -}}
{{- if $isLinux -}}
{{- /* chezmoi's documented WSL check: the kernel osrelease contains "microsoft" */ -}}
{{-   $isWSL = .chezmoi.kernel.osrelease | default "" | lower | contains "microsoft" -}}
{{- end -}}

{{- /* Git identity: work by default, personal via includeIf gitdir:~/src/personal/ */ -}}
{{- $name := promptStringOnce . "name" "Git user.name" "Jorgen V" -}}
{{- $email := promptStringOnce . "email" "Work email (default git identity)" "jorgen.vik@kystverket.no" -}}
{{- $personalEmail := promptStringOnce . "personalEmail" "Personal email (repos under ~/src/personal/)" "mail@jvik.no" -}}
{{- /* Public key only; the private key lives in the Bitwarden SSH agent. "" disables commit signing. */ -}}
{{- $signingKey := promptStringOnce . "signingKey" "SSH public key for commit signing (empty disables signing)" "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPzWi+NokP2tWZOMWl92oWK3A5bbfX4C1tPgtDkH08iF" -}}
{{- $githubOrg := promptStringOnce . "githubOrg" "Work GitHub org for ghfco/ghfuzzyclone (empty = none)" "" -}}
{{- $wslDistro := promptStringOnce . "wslDistro" "WSL distro name" "Ubuntu" -}}
{{- $obsidianVault := promptStringOnce . "obsidianVault" "Windows path of the Obsidian vault for .obsidian.vimrc (empty = skip)" "" -}}

{{- /* Windows username, needed in WSL for /mnt/c/Users/<windowsUser>/... paths.
       Windows: %USERNAME%. WSL: ask cmd.exe through interop. Prompt only if
       neither works (interop disabled, unusual automount root, ...). */ -}}
{{- $windowsUser := index . "windowsUser" | default "" -}}
{{- if not $windowsUser -}}
{{-   if $isWindows -}}
{{-     $windowsUser = env "USERNAME" -}}
{{-   else if $isWSL -}}
{{-     if stat "/mnt/c/Windows/System32/cmd.exe" -}}
{{- /* /d skips cmd AutoRun; the "UNC paths are not supported" warning goes to stderr */ -}}
{{-       $windowsUser = output "/mnt/c/Windows/System32/cmd.exe" "/d" "/c" "echo %USERNAME%" | trim -}}
{{-       if contains "%" $windowsUser -}}
{{-         $windowsUser = "" -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if not $windowsUser -}}
{{-   $windowsUser = promptString "Windows username (for /mnt/c/Users/<name>)" .chezmoi.username -}}
{{- end -}}

{{- /* Optional subsystems */ -}}
{{- $docker := promptBoolOnce . "features.docker" "Install Docker Engine (docker-ce) inside WSL" true -}}
{{- $agentSandbox := promptBoolOnce . "features.agentSandbox" "Install herdr + agent-sandbox + new-worktree (WSL)" true -}}
{{- $powertoys := promptBoolOnce . "features.powertoys" "Install PowerToys with Keyboard Manager remaps (Windows)" true -}}
{{- $glazewm := promptBoolOnce . "features.glazewm" "Install the GlazeWM tiling window manager, started at sign-in (Windows)" true -}}

# Generated by chezmoi from home/.chezmoi.yaml.tmpl - edit the template, then
# run `chezmoi init` to regenerate (stored answers are kept).

{{/* Persist the source location so a plain `chezmoi apply` works later.
     .chezmoi.workingTree is the repo root (the git work tree, or the --source
     dir when there is no .git yet); .chezmoi.sourceDir would be <root>/home
     because of .chezmoiroot, and chezmoi must be pointed at the root so it
     reads .chezmoiroot itself. Both sides use the same Windows checkout:
     bootstrap.ps1 passes it with --source on Windows; in WSL it is the same
     directory under /mnt/c, passed by bootstrap-wsl.sh and by
     run_after_90-wsl-apply. Reading it over 9P adds about a second per WSL
     apply; .gitattributes and .editorconfig keep it LF, and chezmoi takes
     file modes from the source names, not from NTFS. */ -}}
sourceDir: {{ .chezmoi.workingTree | quote }}

{{/* No [interpreters] override: chezmoi runs .ps1 with pwsh when found and
     falls back to Windows PowerShell 5.1, and every script is written to be
     5.1-compatible pure ASCII. The machine's GPO execution policy is
     RemoteSigned, which allows the local temp scripts chezmoi writes. */ -}}

{{- if $isWindows }}
merge:
  # Three-way merge in VS Code (same flow as before, PowerShell instead of bash).
  command: powershell.exe
  args:
    - -NoLogo
    - -NoProfile
    - -Command
    - {{ `Copy-Item -LiteralPath {{ .Target | squote }} -Destination {{ printf "%s.base" .Target | squote }}; code --new-window --wait --merge {{ .Destination | squote }} {{ .Target | squote }} {{ printf "%s.base" .Target | squote }} {{ .Source | squote }}` | quote }}
{{- else }}
merge:
  # Three-way merge in VS Code (Remote-WSL `code` shim).
  command: bash
  args:
    - -c
    - {{ `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` | quote }}
{{- end }}

data:
  isWindows: {{ $isWindows }}
  isWSL: {{ $isWSL }}
  isLinux: {{ $isLinux }}
  name: {{ $name | quote }}
  email: {{ $email | quote }}
  personalEmail: {{ $personalEmail | quote }}
  signingKey: {{ $signingKey | quote }}
  githubOrg: {{ $githubOrg | quote }}
  wslDistro: {{ $wslDistro | quote }}
  windowsUser: {{ $windowsUser | quote }}
  obsidianVault: {{ $obsidianVault | quote }}
  features:
    docker: {{ $docker }}
    agentSandbox: {{ $agentSandbox }}
    powertoys: {{ $powertoys }}
    glazewm: {{ $glazewm }}
