# Global gitignore (git's default core.excludesFile: ~/.config/git/ignore).
# Used by git on both Windows and WSL. Keep it to editor/OS cruft only;
# project-specific patterns belong in the project's .gitignore.

# Vim/Neovim swap and backup files
*.swp
*.swo
.*.sw?
*~

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Per-user local overrides
mise.local.toml
.mise.local.toml

# Claude Code scratch dir. Claude appends this line itself when it is missing,
# which made the managed file conflict on apply; keeping it here stops that.
**/.claude/.cc-writes/

# Claude Code's per-project local settings (personal permissions). Claude adds
# this line itself too, so it is kept here for the same reason.
**/.claude/settings.local.json
