# Environment variables for Fish shell

# XDG Base Directory
set -gx XDG_CONFIG_HOME $HOME/.config
set -gx XDG_CACHE_HOME $HOME/.cache
set -gx XDG_DATA_HOME $HOME/.local/share

# Editor configuration
if type -q nvim
    set -gx EDITOR nvim
    set -gx MANPAGER 'nvim +Man!'
else if type -q vim
    set -gx EDITOR vim
else
    set -gx EDITOR vi
end

set -gx USE_EDITOR $EDITOR
set -gx VISUAL $EDITOR

# Browser: set in wsl.fish (wsl-open hands URLs to the Windows default browser)

# Enable colors
set -gx CLICOLOR 1

# History configuration
set -gx HISTSIZE 10000

# SSH Auth Socket: set in wsl.fish (wsl2-ssh-agent bridge to the Bitwarden
# Desktop SSH agent on Windows)

# SOPS age key, fetched from Bitwarden on demand. sops splits this shell-style
# and execs it without a shell, so the pipe needs an explicit `sh -c`.
set -gx SOPS_AGE_KEY_CMD "sh -c 'bw get item age-key | jq -r \".fields[] | select(.name==\\\"private-key\\\") | .value\"'"

# GitHub org used by ghfco, krepo and krepo-update (chezmoi data: githubOrg).
# local.fish can still override it.
{{- if .githubOrg }}
set -gx gh_org {{ .githubOrg }}
{{- else }}
# (githubOrg is empty in the chezmoi config; set gh_org in local.fish)
{{- end }}

# Homebrew (Linuxbrew) owns the general CLIs in WSL. shellenv puts it on PATH
# and sets MANPATH/INFOPATH/HOMEBREW_*. Guarded so a fresh distro without brew
# still gets a working shell.
if test -x /home/linuxbrew/.linuxbrew/bin/brew
    /home/linuxbrew/.linuxbrew/bin/brew shellenv fish | source
end

# PATH configuration
fish_add_path -p /usr/local/bin
fish_add_path -p $HOME/bin
fish_add_path -p $HOME/go/bin
fish_add_path -p $HOME/.local/bin
fish_add_path -p $HOME/.cargo/bin

# mise version manager (version-pinned tools from ~/.config/mise/config.toml)
if type -q mise
    mise activate fish | source
end

# GitHub token
if type -q gh
    set -l token (gh auth token 2>/dev/null)
    and set -gx GITHUB_TOKEN $token
end
