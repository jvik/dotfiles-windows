root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# fish_indent, PowerShell and shell scripts use 4 spaces
[*.{fish,ps1,psm1,sh,bash}]
indent_size = 4

[*.{fish,ps1,psm1,sh,bash}.tmpl]
indent_size = 4

[justfile]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
